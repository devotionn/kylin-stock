{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "物资管理系统",
  "version": "0.1.0",
  "identifier": "com.devotionn.kylinstock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "物资管理系统",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "物资出入库与库存管理系统",
    "resources": [
      "resources/ocr_worker.py"
    ]
  }
}